# ──────────────────────────────────────────────────────────────
# SENTRI Backend — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Voyage AI API key for generating embeddings via voyage-3
# Obtain from: https://dash.voyageai.com/
VOYAGE_API_KEY=your_voyage_api_key_here

# Anthropic API key for claude-sonnet-4-6 Hindsight reflections (Phase 3)
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ChromaDB instance URL (default: local Docker container)
CHROMA_URL=http://localhost:8000

# Express server port
PORT=3001
