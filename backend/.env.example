# ──────────────────────────────────────────────────────────────
# SENTRI Backend — Environment Variables
# Copy this to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────

# Voyage AI API key for generating embeddings via voyage-3
# Obtain from: https://dash.voyageai.com/
VOYAGE_API_KEY=your_voyage_key_here

# ChromaDB instance URL (default: local Docker container)
CHROMA_URL=http://localhost:8000

# Express server port
PORT=3001

# Ollama REST API endpoint (default: local Ollama instance)
# No API key needed — Ollama runs entirely locally
OLLAMA_URL=http://localhost:11434
