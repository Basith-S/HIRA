{
  "name": "sentri-backend",
  "version": "0.2.0",
  "description": "SENTRI / HIRA — Phase 2 memory subsystem backend (Express + ChromaDB + Voyage AI)",
  "private": true,
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "validate": "ts-node scripts/runValidation.ts",
    "simulate": "ts-node scripts/cliAgent.ts"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "chromadb": "^1.9.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/uuid": "^10.0.0",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.2"
  }
}
